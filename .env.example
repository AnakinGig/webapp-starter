# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# App
# Canonical URL of the deployed app, used for SEO metadata (optional; defaults to http://localhost:3000 in src/lib/app.ts)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SingleStore
# Connection details for your SingleStore deployment.
# Helios (cloud): the endpoint host shown under Connect in the workspace UI (e.g. svc-xxxx.svc.singlestore.com).
# Local: host "localhost" (port 3306), set SINGLESTORE_SSL="false".
SINGLESTORE_HOST="svc-xxxx-xxxxxxxx.svc.singlestore.com"
SINGLESTORE_PORT="3306"
SINGLESTORE_USER="admin"
SINGLESTORE_PASSWORD="your-password"
SINGLESTORE_DATABASE="webapp_starter"
# TLS is required by SingleStore Helios ("true"); use "false" for local deployments without TLS.
SINGLESTORE_SSL="true"

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET="your-random-secret"
# Base URL for Better Auth callbacks and redirects (e.g. http://localhost:3000)
BETTER_AUTH_URL="http://localhost:3000"

# Better Auth GitHub OAuth
# Required even in dev (dummy values work, but the redirect URI is hardcoded to http://localhost:3000)
BETTER_AUTH_GITHUB_CLIENT_ID="dummy-github-client-id"
BETTER_AUTH_GITHUB_CLIENT_SECRET="dummy-github-client-secret"
