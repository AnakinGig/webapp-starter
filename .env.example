# Copy to .env / .env.local and fill in your values.
# When adding env vars, update the schema in "/src/env.js" accordingly.

# Convex
# ---------
# The Convex CLI writes CONVEX_DEPLOYMENT, NEXT_PUBLIC_CONVEX_URL and
# NEXT_PUBLIC_CONVEX_SITE_URL to .env.local automatically when you run
# `npx convex dev` (replace the placeholders below if you set them by hand).
NEXT_PUBLIC_CONVEX_URL="https://your-project.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-project.convex.site"

# Canonical app URL (SEO/metadata; defaults to http://localhost:3000).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth & email secrets live ON THE CONVEX DEPLOYMENT, not in this file.
# Set them with the Convex CLI or the dashboard:
#
#   npx convex env set BETTER_AUTH_SECRET "<random secret, e.g. openssl rand -base64 32>"
#   npx convex env set SITE_URL "http://localhost:3000"
#   npx convex env set BETTER_AUTH_GITHUB_CLIENT_ID "<github oauth app id>"
#   npx convex env set BETTER_AUTH_GITHUB_CLIENT_SECRET "<github oauth app secret>"
#   npx convex env set RESEND_API_KEY "re_..."      # optional: without it, auth
#   npx convex env set RESEND_EMAIL_FROM "Basis <no-reply@yourdomain.com>"  # links are logged to the console in dev
#
# Keep RESEND_API_KEY empty/unset for local development - verification and
# reset links are printed to the terminal instead of emailed.
