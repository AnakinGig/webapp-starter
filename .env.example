# Copy to .env / .env.local and fill in your values.
# When adding env vars, update the schema in "/src/env.js" accordingly.

# Convex
# ---------
# The Convex CLI writes CONVEX_DEPLOYMENT, NEXT_PUBLIC_CONVEX_URL and
# NEXT_PUBLIC_CONVEX_SITE_URL to .env.local automatically when you run
# `npx convex dev` (replace the placeholders below if you set them by hand).
NEXT_PUBLIC_CONVEX_URL="https://your-project.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://your-project.convex.site"

# Canonical app URL (SEO/metadata; defaults to http://localhost:3000).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth & email secrets live ON THE CONVEX DEPLOYMENT, not in this file.
# Set them with the Convex CLI or the dashboard:
#
#   pnpx convex env set BETTER_AUTH_SECRET "<random secret, e.g. openssl rand -base64 32>"
#   pnpx convex env set SITE_URL "http://localhost:3000"
#
# OAuth providers are env-driven: set BETTER_AUTH_<PROVIDER>_CLIENT_ID and
# BETTER_AUTH_<PROVIDER>_CLIENT_SECRET to enable that provider everywhere
# (login/register buttons, Settings -> Account). Supported providers:
#   APPLE, DISCORD, FACEBOOK, FIGMA, GITHUB, GITLAB, GOOGLE, KAKAO, LINEAR,
#   LINKEDIN, MICROSOFT, NOTION, SPOTIFY, TIKTOK, TWITCH, TWITTER
# The provider's OAuth app must allow callbacks under your SITE_URL
# (e.g. http://localhost:3000/api/auth/callback/github).
#   pnpx convex env set BETTER_AUTH_GITHUB_CLIENT_ID "<github oauth app id>"
#   pnpx convex env set BETTER_AUTH_GITHUB_CLIENT_SECRET "<github oauth app secret>"
#   pnpx convex env set BETTER_AUTH_GOOGLE_CLIENT_ID "<google oauth client id>"
#   pnpx convex env set BETTER_AUTH_GOOGLE_CLIENT_SECRET "<google oauth client secret>"
#   pnpx convex env set RESEND_API_KEY "re_..."      # optional: without it, auth
#   pnpx convex env set RESEND_EMAIL_FROM "Basis <no-reply@yourdomain.com>"  # links are logged to the console in dev
#   pnpx convex env set ENVIRONMENT "production"      # only on the production deployment
#
# Keep RESEND_API_KEY empty/unset for local development - verification and
# reset links are printed to the terminal instead of emailed.
#
# Dev vs prod is decided by the ENVIRONMENT variable, NOT NODE_ENV: Convex
# sets NODE_ENV to "production" on every deployment, even dev ones. With
# ENVIRONMENT unset (or anything but "production"), a missing RESEND_API_KEY
# logs the action link to the function logs so flows stay testable. Set
# ENVIRONMENT to "production" on the production deployment so a missing
# RESEND_API_KEY logs a clear error WITHOUT leaking the token-bearing link.
